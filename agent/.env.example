# ---- LiveKit ---------------------------------------------------------------
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Models ----------------------------------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

ELB_TRANSLATE_MODEL=claude-haiku-4-5
ELB_EXTRACT_MODEL=claude-haiku-4-5
ELB_REPORT_MODEL=claude-opus-5
ELB_STT_MODEL=nova-3
ELB_TTS_MODEL=eleven_flash_v2_5
# Any ElevenLabs voice id. Default pair is intentionally distinct so each side
# can tell instantly whether it is hearing its own interpreter.
ELB_TTS_VOICE_OPERATOR=EXAVITQu4vr4xnSDxMaL
ELB_TTS_VOICE_CALLER=ODq5zmih8GrVes37Dizd

# ---- Latency budget --------------------------------------------------------
ELB_TRANSLATE_TIMEOUT_S=3.5
ELB_STT_TIMEOUT_S=4.0

# ---- Early notification gate ----------------------------------------------
ELB_EXTRACT_INTERVAL_S=6
ELB_NOTIFY_LOC_CONF=0.75
ELB_NOTIFY_TYPE_CONF=0.70
ELB_NOTIFY_STABLE_PASSES=2
ELB_NOTIFY_MIN_ELAPSED_S=12

# ---- Storage + delivery ----------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ELB_WEB_BASE_URL=http://localhost:3000
ELB_NOTIFY_ENDPOINT=
# openssl rand -hex 32   <- MUST match ELB_REPORT_SIGNING_SECRET in web/.env.local
ELB_REPORT_SIGNING_SECRET=
# openssl rand -hex 24   <- MUST match ELB_INTERNAL_TOKEN in web/.env.local
ELB_INTERNAL_TOKEN=
ELB_LINK_TTL_EARLY_S=21600
ELB_LINK_TTL_FINAL_S=259200

# ---- Misc ------------------------------------------------------------------
ELB_OPERATOR_LANG=es

# NOTE: the ElevenLabs plugin looks for ELEVEN_API_KEY when no api_key is passed.
# We always pass it explicitly from ELEVENLABS_API_KEY, so only that one is needed.
