# ---- LiveKit (server side) -------------------------------------------------
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same value as LIVEKIT_URL, exposed to the browser
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud

# ---- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Shared secrets (MUST match agent/.env) -------------------------------
ELB_REPORT_SIGNING_SECRET=
ELB_INTERNAL_TOKEN=

# ---- Email delivery (the only outbound channel) -----------------------------
# Gmail SMTP. GMAIL_USER is the full Google account address; GMAIL_APP_PASSWORD
# is a 16-character App Password from myaccount.google.com/apppasswords, NOT
# the account password. Requires 2-Step Verification on the account.
# Spaces in the App Password are stripped automatically.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name. Defaults to GMAIL_USER when unset.
MAIL_FROM="AuXio <alerts@example.com>"
# Override only to point at a non-Gmail SMTP server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---- Misc ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Emergency Language Bridge"
