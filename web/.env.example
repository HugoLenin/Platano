# ---- LiveKit (server side) -------------------------------------------------
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same value as LIVEKIT_URL, exposed to the browser
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud

# ---- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Shared secrets (MUST match agent/.env) -------------------------------
ELB_REPORT_SIGNING_SECRET=
ELB_INTERNAL_TOKEN=

# ---- WhatsApp via Kapso ----------------------------------------------------
# Either route through Kapso's proxy (recommended - gives storage + history)...
KAPSO_API_KEY=
KAPSO_BASE_URL=https://app.kapso.ai/api/meta/
# ...or talk to Meta directly by setting this instead of KAPSO_API_KEY
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of the template approved by Meta (see docs/WHATSAPP_TEMPLATE.md)
WHATSAPP_TEMPLATE_NAME=elb_emergency_alert
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me

# ---- Optional email fallback (Resend) --------------------------------------
RESEND_API_KEY=
RESEND_FROM="Emergency Language Bridge <alerts@example.com>"

# ---- Misc ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Emergency Language Bridge"
