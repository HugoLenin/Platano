# ---------------------------------------------------------------- secrets
# Nothing with a real credential in it, ever. Only the .example files are
# tracked (agent/.env.example, web/.env.example).
.env
.env.*
!.env.example
*.local

# Android build-time config: local.properties holds the absolute SDK path of
# whoever built last, elb.properties holds the backend IP and default room.
android/local.properties
android/elb.properties
*.keystore
*.jks

# ------------------------------------------------------------------- node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.vercel

# web/lib/critical_terms.json is COMMITTED on purpose: glossary.ts imports it at
# build time, and a deploy whose build root is web/ may not have the repo root
# checked out. sync-glossary.mjs refreshes it from shared/ when it can.
# shared/critical_terms.json remains the single source of truth - never edit the copy.

# ----------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- android
.gradle/
build/
android/app/build/
# Copied in by the syncGlossary Gradle task from shared/critical_terms.json.
android/app/src/main/assets/critical_terms.json
*.apk
*.aab
captures/
.cxx/

# ------------------------------------------------------------------ output
# Report .txt files written by the agent at the end of a call. They contain
# real transcripts of real emergencies.
reports/

# -------------------------------------------------------------------- IDE
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
